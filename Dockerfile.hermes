FROM oven/bun:1.3.5 AS build

WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY backend ./backend
COPY convex/_generated ./convex/_generated
RUN bun build backend/worker/main.ts --target=node --outfile=/out/worker.js

FROM nousresearch/hermes-agent:latest

USER root
COPY --from=build /out/worker.js /opt/afterimage/worker.js
COPY --from=build /app/backend/hermes-skills /opt/afterimage/skills
RUN chown -R hermes:hermes /opt/afterimage

ENV API_SERVER_ENABLED=true \
    API_SERVER_HOST=127.0.0.1 \
    API_SERVER_PORT=8642 \
    PORT=8080

EXPOSE 8080
CMD ["node", "/opt/afterimage/worker.js"]
